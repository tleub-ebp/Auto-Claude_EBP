# src/main/__tests__/ipc-handlers.test.ts writes fixtures to ../../tmp,
# which resolves to the repo root.
/tmp/
# electron-vite writes a timestamped config bundle next to the config file.
apps/frontend/electron.vite.config.*.mjs

# Development
# NOTE: /docs is deliberately NOT ignored. It was, which meant every new file
# under docs/ was silently dropped from `git add` while the 10 already-tracked
# ones kept working — a trap, especially now that the README links into docs/.
dev/
_bmad/
# Skill packs vendored on demand by `pnpm run skills:bootstrap`. Only the
# pack.json manifest is committed -- the content is third-party, has its own
# release cadence, and is pinned by tree SHA in skills-lock.json instead.
skills/superpowers/*
!skills/superpowers/pack.json
skills/mattpocock/*
!skills/mattpocock/pack.json
skills/impeccable/*
!skills/impeccable/pack.json
skills/task-observer/*
!skills/task-observer/pack.json
_bmad-output/
.claude/
/.github/agents

# WorkPilot AI generated files
.security-key
logs/security/
nul

# ===========================
# Runtime data (SQLite, lint reports)
# ===========================
*.sqlite3
*.sqlite3-journal
/apps/backend/analytics.db
/apps/backend/test_analytics.db
/data/analytics.db
/data/test_analytics.db
# Test-generated SQLite DBs can also land at the repo root depending on cwd.
/analytics.db
/test_analytics.db
/apps/frontend/lint_output.txt
tmp/ipc-handlers-test/userData/store/projects.json

# Generated security-scan reports (bandit) — must never be committed.
bandit-report.json
apps/backend/bandit-report.json

# Per-agent experience ledgers, written by the `observe` phase on every build.
# The proposals themselves (skills/_proposed/*.md) ARE committed — they are the
# reviewable diff — and each one embeds the signals and build ids that earned
# it, so the evidence is in the pull request without the raw tally churning.
skills/_proposed/_ledgers/
# skills-cli: vendored on demand (claude-mem)
skills/claude-mem/*
!skills/claude-mem/pack.json

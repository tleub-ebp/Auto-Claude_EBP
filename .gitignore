.worktrees/

# ===========================
# WorkPilot AI Generated
# ===========================
# Note the trailing /* rather than /: git cannot re-include a file whose
# parent directory is excluded, so ignoring the directory itself would make the
# negations below dead letters (which is why the .md files here were previously
# kept alive by `git add -f`). These four are inputs, not runtime state -- CI
# must resolve the same skills a developer does, and it cannot do that if the
# config is not committed.
.workpilot/*
!.workpilot/architecture.md
!.workpilot/conventions.md
!.workpilot/patterns.md
!.workpilot/skills.toml
.planning/
.planning-archive/
.auto-build-security.json
.workpilot-security.json
.workpilot-status
.claude_settings.json
.update-metadata.json

